#version 450
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) readonly buffer Weights { vec4 a[]; };
layout(set=0,binding=1,std430) readonly buffer Input { float b[]; };
layout(set=0,binding=2,std430) writeonly buffer Output { float c[]; };
layout(set=0,binding=3,std430) readonly buffer Bias { float d[]; };
layout(constant_id=0) const uint activation=0;
layout(constant_id=2) const uint ih=1;
layout(constant_id=3) const uint iw=1;
layout(constant_id=5) const uint oh=1;
layout(constant_id=6) const uint ow=1;

void main() {
    uint pixel=gl_GlobalInvocationID.x, spatial=oh*ow, batch=gl_GlobalInvocationID.z;
    if(pixel>=spatial) return;
    int iy=int(pixel/ow*2)-1, ix=int(pixel%ow*2)-1;
    vec4 s0=vec4(0), s1=vec4(0), s2=vec4(0), s3=vec4(0);
    // Weights are Kx16; a warp broadcasts each aligned vec4 weight load.
    // Each input sample feeds all 16 output channels without a workgroup barrier.
    #define MAC(ci,ky,kx) { \
        int y=iy+ky, x=ix+kx; uint k=ci*9+ky*3+kx; \
        float v=(y>=0 && x>=0 && y<int(ih) && x<int(iw)) ? b[((batch*3+ci)*ih+uint(y))*iw+uint(x)] : 0; \
        s0=fma(vec4(v),a[k*4],s0); s1=fma(vec4(v),a[k*4+1],s1); \
        s2=fma(vec4(v),a[k*4+2],s2); s3=fma(vec4(v),a[k*4+3],s3); \
    }
    MAC(0,0,0) MAC(0,0,1) MAC(0,0,2)
    MAC(0,1,0) MAC(0,1,1) MAC(0,1,2)
    MAC(0,2,0) MAC(0,2,1) MAC(0,2,2)
    MAC(1,0,0) MAC(1,0,1) MAC(1,0,2)
    MAC(1,1,0) MAC(1,1,1) MAC(1,1,2)
    MAC(1,2,0) MAC(1,2,1) MAC(1,2,2)
    MAC(2,0,0) MAC(2,0,1) MAC(2,0,2)
    MAC(2,1,0) MAC(2,1,1) MAC(2,1,2)
    MAC(2,2,0) MAC(2,2,1) MAC(2,2,2)
    s0+=vec4(d[0],d[1],d[2],d[3]); s1+=vec4(d[4],d[5],d[6],d[7]);
    s2+=vec4(d[8],d[9],d[10],d[11]); s3+=vec4(d[12],d[13],d[14],d[15]);
    if(activation==1) { s0/=1+exp(-s0); s1/=1+exp(-s1); s2/=1+exp(-s2); s3/=1+exp(-s3); }
    for(uint q=0;q<4;q++) {
        c[(batch*16+q)*spatial+pixel]=s0[q]; c[(batch*16+q+4)*spatial+pixel]=s1[q];
        c[(batch*16+q+8)*spatial+pixel]=s2[q]; c[(batch*16+q+12)*spatial+pixel]=s3[q];
    }
}
