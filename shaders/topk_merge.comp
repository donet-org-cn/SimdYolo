#version 450
layout(local_size_x=128) in;
struct Item { uint bits; uint key; };
layout(set=0,binding=0,std430) readonly buffer Input { Item a[]; };
layout(set=0,binding=2,std430) writeonly buffer Values { uint c[]; };
layout(set=0,binding=3,std430) writeonly buffer Indices { float d[]; };
layout(constant_id=0) const uint rows=1;
layout(constant_id=1) const uint size=1;
layout(constant_id=2) const uint k=1;
layout(constant_id=3) const uint largest=1;
layout(constant_id=4) const uint nanFirst=1;

struct Cursor { uint bits; uint key; uint order; uint segment; uint position; };
shared Cursor heap[256];

uint scoreOrder(uint bits) {
    uint magnitude=bits&0x7fffffffu;
    if(magnitude>0x7f800000u) return nanFirst==1 ? 0xffffffffu : 0;
    if(magnitude==0) bits=0;
    uint order=(bits&0x80000000u)!=0 ? ~bits : bits^0x80000000u;
    return largest==1 ? order : ~order;
}
bool better(Cursor x,Cursor y) {
    return x.order>y.order || (x.order==y.order && x.key<y.key);
}
Cursor readHead(uint base,uint segment,uint position) {
    if(position>=min(256,size-segment*256))
        return Cursor(0,0xffffffffu,0,segment,position);
    Item item=a[base+segment*256+position];
    return Cursor(item.bits,item.key,scoreOrder(item.bits),segment,position);
}
void siftDown(uint slot,uint count,Cursor value) {
    for(uint child=slot*2+1;child<count;child=slot*2+1) {
        Cursor head=heap[child];
        if(child+1<count) {
            Cursor right=heap[child+1];
            if(better(right,head)) { head=right;child++; }
        }
        if(!better(head,value)) break;
        // Shift each child up once; the candidate stays local until its final slot.
        heap[slot]=head;
        slot=child;
    }
    heap[slot]=value;
}
void main() {
    uint tid=gl_LocalInvocationID.x,row=gl_WorkGroupID.x,blocks=(size+255)/256,base=row*blocks*256;
    for(uint segment=tid;segment<blocks;segment+=128)
        heap[segment]=readHead(base,segment,0);
    barrier();
    if(tid!=0) return;
    for(int root=int(blocks/2)-1;root>=0;root--)
        siftDown(uint(root),blocks,heap[root]);
    for(uint i=0;i<k;i++) {
        Cursor head=heap[0];
        c[row*k+i]=head.bits;
        d[row*k+i]=float(head.key);
        if(i+1<k)
            siftDown(0,blocks,readHead(base,head.segment,head.position+1));
    }
}
