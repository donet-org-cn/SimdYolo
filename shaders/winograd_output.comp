#version 450
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) readonly buffer Products { float a[]; };
layout(set=0,binding=1,std430) readonly buffer Bias { float b[]; };
layout(set=0,binding=2,std430) writeonly buffer Output { float c[]; };
layout(set=0,binding=3,std430) readonly buffer Unused { float d[]; };
layout(constant_id=0) const uint spec0=1;
layout(constant_id=1) const uint spec1=1;
layout(constant_id=2) const uint spec2=1;
layout(constant_id=3) const uint spec3=1;
layout(constant_id=4) const uint spec4=1;
layout(constant_id=5) const uint spec5=1;
layout(constant_id=6) const uint spec6=1;
layout(push_constant) uniform Params { uint v[32]; } p;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=spec0) return;
    uint tiles=spec4*spec5,tile=i%tiles,channel=i/tiles%spec1,batch=i/(tiles*spec1),stride=spec1*tiles,base=batch*16*stride+channel*tiles+tile;
    vec4 m0=vec4(a[base],a[base+stride],a[base+2*stride],a[base+3*stride]);
    vec4 m1=vec4(a[base+4*stride],a[base+5*stride],a[base+6*stride],a[base+7*stride]);
    vec4 m2=vec4(a[base+8*stride],a[base+9*stride],a[base+10*stride],a[base+11*stride]);
    vec4 m3=vec4(a[base+12*stride],a[base+13*stride],a[base+14*stride],a[base+15*stride]);
    vec4 t0=m0+m1+m2,t1=m1-m2-m3;
    vec4 result=vec4(t0.x+t0.y+t0.z,t0.y-t0.z-t0.w,t1.x+t1.y+t1.z,t1.y-t1.z-t1.w)+vec4(b[channel]);
    if(spec6==1) result=result/(vec4(1)+exp(-result));
    uint y=tile/spec4*2,x=tile%spec4*2,offset=((batch*spec1+channel)*spec2+y)*spec3+x;
    c[offset]=result.x;
    if(x+1<spec3) c[offset+1]=result.y;
    if(y+1<spec2) { c[offset+spec3]=result.z; if(x+1<spec3) c[offset+spec3+1]=result.w; }
}
