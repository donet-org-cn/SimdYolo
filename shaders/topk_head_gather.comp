#version 450
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) readonly buffer Input { float a[]; };
layout(set=0,binding=1,std430) readonly buffer Keys { float b[]; };
layout(set=0,binding=2,std430) writeonly buffer Output { float c[]; };
layout(set=0,binding=3,std430) readonly buffer Scores { float d[]; };
layout(constant_id=0) const uint count=1;
layout(constant_id=1) const uint anchors=1;
layout(constant_id=2) const uint classes=1;
layout(constant_id=3) const uint k=1;
layout(constant_id=4) const uint inputOffset=0;
layout(constant_id=5) const uint extra=0;
layout(constant_id=6) const uint separatePayload=0;
layout(constant_id=7) const uint payloadOffset=0;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=count) return;
    uint fields=6+extra,column=i%fields,position=i/fields%k,batch=i/(k*fields),key=uint(b[batch*k+position]),anchor=key/classes,category=key%classes;
    // 掩码系数或关键点必须与选中边框使用同一锚点索引。
    uint width=classes+4+(separatePayload==0 ? extra : 0);
    uint base=inputOffset+batch*width*anchors+anchor;
    if(column<4) c[i]=a[base+column*anchors];
    else if(column==4) c[i]=separatePayload==0 ? d[batch*k+position] : a[base+(4+category)*anchors];
    else if(column==5) c[i]=float(category);
    else c[i]=separatePayload==0 ? a[base+(classes+4+column-6)*anchors]
        : d[payloadOffset+(batch*extra+column-6)*anchors+anchor];
}
