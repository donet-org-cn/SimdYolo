#version 450
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) readonly buffer Input { uint a[]; };
layout(set=0,binding=1,std430) readonly buffer Keys { float b[]; };
struct Item { uint bits; uint key; };
layout(set=0,binding=2,std430) writeonly buffer Output { Item c[]; };
layout(constant_id=0) const uint rows=1;
layout(constant_id=1) const uint size=1;
layout(constant_id=2) const uint k=1;
layout(constant_id=3) const uint largest=1;
layout(constant_id=4) const uint nanFirst=1;
layout(constant_id=5) const uint inputOffset=0;
layout(constant_id=6) const uint keyed=0;
layout(constant_id=7) const uint keyOffset=0;
struct RankedItem { uint bits; uint key; uint order; };
shared RankedItem items[256];

uint scoreOrder(uint bits) {
    uint magnitude=bits&0x7fffffffu;
    if(magnitude>0x7f800000u) return nanFirst==1 ? 0xffffffffu : 0;
    if(magnitude==0) bits=0;
    uint order=(bits&0x80000000u)!=0 ? ~bits : bits^0x80000000u;
    return largest==1 ? order : ~order;
}
bool better(RankedItem x,RankedItem y) {
    return x.order>y.order || (x.order==y.order && x.key<y.key);
}
void main() {
    uint tid=gl_LocalInvocationID.x,row=gl_WorkGroupID.y,start=gl_WorkGroupID.x*256;
    for(uint j=0;j<2;j++) {
        uint local=tid+j*128,i=start+local;
        if(i<size) {
            uint bits=a[inputOffset+row*size+i];
            uint key=keyed==1 ? uint(b[keyOffset+row*size+i]) : i;
            // Keep the original bits for signed zero, subnormals and NaN payloads.
            items[local]=RankedItem(bits,key,scoreOrder(bits));
        } else {
            items[local]=RankedItem(0,0xffffffffu,0);
        }
    }
    barrier();
    for(uint length=2;length<=256;length*=2) {
        for(uint stride=length/2;stride>0;stride/=2) {
            // Each pair has one writer, avoiding cross-warp read/write races.
            uint i=(tid/stride)*(stride*2)+tid%stride,j=i+stride;
            RankedItem x=items[i],y=items[j];
            bool bestFirst=(i&length)==0;
            if(bestFirst ? better(y,x) : better(x,y)) { items[i]=y;items[j]=x; }
            barrier();
        }
    }
    uint blocks=(size+255)/256,outputBase=(row*blocks+gl_WorkGroupID.x)*256;
    for(uint j=0;j<2;j++) {
        uint i=tid+j*128;
        c[outputBase+i]=Item(items[i].bits,items[i].key);
    }
}
