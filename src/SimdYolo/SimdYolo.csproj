<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.11.5</Version>
    <PackageReleaseNotes>ARM64 NEON convolution panels, CPU INT8 SIMD dispatch, MaxPool ceil-mode support, PlateNet ONNX export, and Android Vulkan loading. AVX-512 requires explicit opt-in. https://github.com/donet-org-cn/SimdYolo/releases/tag/v0.11.5</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Managed FP32 YOLO detection, segmentation and pose inference with SIMD, Vulkan and Metal compute.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../shaders/*.spv" />
    <EmbeddedResource Include="../../shaders/gemm.metal" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../VALIDATION.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
