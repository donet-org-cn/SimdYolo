<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.11.6</Version>
    <PackageReleaseNotes>Faster CPU and Vulkan inference, pooled image buffers, reduced Winograd workspace, and stable ties in Vulkan TopK. https://github.com/donet-org-cn/SimdYolo/releases/tag/v0.11.6</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Managed FP32 YOLO detection, segmentation and pose inference with SIMD, Vulkan and Metal compute.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../shaders/*.spv" />
    <EmbeddedResource Include="../../shaders/gemm.metal" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../VALIDATION.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
