<Project>
  <PropertyGroup>
    <!-- 按发布平台预编译应用，NuGet 主库和普通构建仍保留纯托管 IL。 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
</Project>
